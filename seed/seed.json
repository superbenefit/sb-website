  "collections": [
    {
      "slug": "pages",
      "label": "Pages",
      "labelSingular": "Page",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "seo"
      ],
      "urlPattern": "/{slug}",
      "fields": [
        {
          "slug": "title",
          "label": "Page name",
          "type": "string",
          "required": true
        },
        {
          "slug": "layout",
          "label": "Sections",
          "type": "blocks",
          "validation": {
            "allowedTypes": [
              "hero",
              "text_section",
              "offer_panel",
              "project_showcase",
              "latest_updates",
              "item_list",
              "support_list",
              "service_list",
              "contact_form"
            ],
            "maxItems": 12
          }
        }
      ],
      "description": "The fixed pages of the site. Each page is a list of sections, shown in order.",
      "icon": "files",
      "sortOrder": 1,
      "titleField": "title"
    },
    {
      "slug": "projects",
      "label": "Projects",
      "labelSingular": "Project",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "seo"
      ],
      "urlPattern": "/projects/{slug}",
      "fields": [
        {
          "slug": "title",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "slug": "summary",
          "label": "Description",
          "type": "text",
          "required": true,
          "validation": {
            "minLength": 60,
            "maxLength": 240
          }
        },
        {
          "slug": "project_status",
          "label": "Status",
          "type": "select",
          "required": true,
          "validation": {
            "options": [
              "active",
              "applicant",
              "past"
            ]
          }
        },
        {
          "slug": "cover",
          "label": "Cover",
          "type": "image",
          "required": true
        },
        {
          "slug": "logo",
          "label": "Logo",
          "type": "image"
        },
        {
          "slug": "body",
          "label": "About the project",
          "type": "portableText"
        },
        {
          "slug": "partner",
          "label": "Partners",
          "type": "string"
        },
        {
          "slug": "location",
          "label": "Location",
          "type": "string"
        },
        {
          "slug": "website",
          "label": "Website",
          "type": "url"
        },
        {
          "slug": "updates",
          "label": "Updates",
          "type": "reference",
          "validation": {
            "relation": "updates_project"
          }
        },
        {
          "slug": "featured",
          "label": "Show on the home page",
          "type": "boolean"
        },
        {
          "slug": "order",
          "label": "Position",
          "type": "integer"
        }
      ],
      "description": "Projects in the network. Each has its own page under /projects/.",
      "icon": "rocket-launch",
      "sortOrder": 2,
      "titleField": "title",
      "admin": {
        "listColumns": [
          "project_status",
          "featured",
          "order"
        ]
      }
    },
    {
      "slug": "updates",
      "label": "Updates",
      "labelSingular": "Update",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "seo"
      ],
      "urlPattern": "/updates/{slug}",
      "fields": [
        {
          "slug": "title",
          "label": "Title",
          "type": "string",
          "required": true
        },
        {
          "slug": "excerpt",
          "label": "Summary",
          "type": "text"
        },
        {
          "slug": "cover",
          "label": "Cover",
          "type": "image"
        },
        {
          "slug": "body",
          "label": "Text",
          "type": "portableText"
        },
        {
          "slug": "project",
          "label": "Project",
          "type": "reference",
          "validation": {
            "relation": "updates_project"
          }
        }
      ],
      "description": "Articles and news. Each has its own page under /updates/.",
      "icon": "newspaper",
      "sortOrder": 3,
      "titleField": "title",
      "dateField": "publishedAt"
    },
    {
      "slug": "services",
      "label": "Services",
      "labelSingular": "Service",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "seo"
      ],
      "routable": false,
      "urlPattern": "/services",
      "fields": [
        {
          "slug": "title",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "slug": "summary",
          "label": "Description",
          "type": "text"
        },
        {
          "slug": "service_type",
          "label": "Service type",
          "type": "string"
        },
        {
          "slug": "audience",
          "label": "Audience",
          "type": "text"
