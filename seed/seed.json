          "type": "repeater",
          "validation": {
            "subFields": [
              {
                "slug": "item",
                "label": "Output",
                "type": "string",
                "required": true
              }
            ]
          }
        },
        {
          "slug": "service_terms",
          "label": "Terms of service",
          "type": "string"
        },
        {
          "slug": "body",
          "label": "Details",
          "type": "portableText"
        },
        {
          "slug": "order",
          "label": "Position",
          "type": "integer"
        }
      ],
      "description": "What SuperBenefit offers to communities and organizations, shown by the \"Services list\" section. Fields are named after schema.org Service: name, description, serviceType, audience, serviceOutput, termsOfService.",
      "icon": "handshake",
      "sortOrder": 4,
      "titleField": "title",
      "admin": {
        "listColumns": [
          "service_type",
          "service_terms",
          "order"
        ]
      }
    },
    {
      "slug": "supports",
      "label": "Supports",
      "labelSingular": "Support",
      "description": "What cells in the Peer to Peer Accelerator get, shown by the \"Supports list\" section.",
      "icon": "lifebuoy",
      "sortOrder": 5,
      "titleField": "title",
      "supports": [
        "drafts",
        "revisions",
        "preview",
        "seo"
      ],
      "routable": false,
      "urlPattern": "/accelerator",
      "admin": {
        "listColumns": [
          "order"
        ]
      },
      "fields": [
        {
          "slug": "title",
          "label": "Name",
          "type": "string",
          "required": true
        },
        {
          "slug": "summary",
          "label": "Description",
          "type": "text"
        },
        {
          "slug": "body",
          "label": "Details",
          "type": "portableText"
        },
        {
          "slug": "order",
