{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sb-website",
  "compatibility_date": "2026-11-17",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": ["contact@superbenefit.org"]
    }
  ],
  // Contact action: at most 5 posts per client IP per 60 seconds, counted
  // per Cloudflare location. namespace_id must be unique in the account:
  // https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "2501",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAADtinm8-q80lFVL-"
  },
  "observability": {
    "enabled": true
  },
  // Settings for Worker Previews (branch builds). Previews do not use the
  // top-level bindings, so the ones the Worker reads at runtime are repeated:
  // https://developers.cloudflare.com/workers/previews/configuration/
  "previews": {
    "send_email": [
      {
        "name": "EMAIL",
        "allowed_destination_addresses": ["contact@superbenefit.org"]
      }
    ],
    // Own namespace, so preview traffic does not count against production.
    "ratelimits": [
      {
        "name": "CONTACT_RATE_LIMITER",
        "namespace_id": "2502",
        "simple": { "limit": 5, "period": 60 }
      }
    ]
  }
}
