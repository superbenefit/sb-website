---
/**
 * Wave divider between two sections: the `dv` rules in
 * docs/relaunch/mockups/mockups.css. `bg` is the colour of the section above,
 * `fill` the colour of the section below. The plain wave carries a charcoal
 * line along its edge; `bands` is the red, orange, gold and green variant the
 * mockups use under dark page heroes, ending in `fill`.
 */
type Bg = 'black' | 'charcoal' | 'cream' | 'paper' | 'green' | 'orange' | 'gold' | 'red';
type Fill = 'charcoal' | 'cream' | 'paper' | 'green' | 'gold' | 'black';

interface Props {
  bg: Bg;
  fill: Fill;
  bands?: boolean;
}

const { bg, fill, bands = false } = Astro.props;
const wave = 'M0,0 C360,80 1080,0 1440,60 L1440,400 L0,400 Z';
const edge = 'M0,0 C360,80 1080,0 1440,60';
const bandFills = ['red', 'orange', 'gold', 'green'];
---

<div class:list={['dv', `bg-${bg}`, { 'dv--bands': bands }]} aria-hidden="true">
  {bands ? (
    <svg viewBox="0 0 1440 116" preserveAspectRatio="none">
      {[...bandFills, fill].map((name, i) => (
        <path class={`f-${name}`} transform={`translate(0,${3 + i * 9})`} d={wave} />
      ))}
    </svg>
  ) : (
    <svg viewBox="0 0 1440 80" preserveAspectRatio="none">
      <path class={`f-${fill}`} transform="translate(0,3)" d={wave} />
      <path class="dv__ink" transform="translate(0,3)" d={edge} />
    </svg>
  )}
</div>

<style>
  .dv {
    display: block;
    line-height: 0;
    margin-bottom: -1px;
  }

  .dv > svg {
    display: block;
    width: 100%;
    height: 60px;
  }

  .dv--bands > svg {
    height: 87px;
  }

  .dv__ink {
    fill: none;
    stroke: var(--color-charcoal);
    stroke-width: 2px;
    vector-effect: non-scaling-stroke;
  }

  .bg-black { background: var(--color-black); }
  .bg-charcoal { background: var(--color-charcoal); }
  .bg-cream { background: var(--color-cream); }
  .bg-paper { background: var(--color-cream-light); }
  .bg-green { background: var(--color-green-sage); }
  .bg-orange { background: var(--color-orange); }
  .bg-gold { background: var(--color-gold); }
  .bg-red { background: var(--color-red-deep); }

  .f-red { fill: var(--color-red); }
  .f-orange { fill: var(--color-orange); }
  .f-gold { fill: var(--color-gold); }
  .f-green { fill: var(--color-green-sage); }
  .f-charcoal { fill: var(--color-charcoal); }
  .f-cream { fill: var(--color-cream); }
  .f-paper { fill: var(--color-cream-light); }
  .f-black { fill: var(--color-black); }

  @media (min-width: 900px) {
    .dv > svg {
      height: 80px;
    }

    .dv--bands > svg {
      height: 116px;
    }
  }
</style>
