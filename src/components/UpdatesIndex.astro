---
/**
 * The updates index, one page of it: docs/relaunch/mockups/pages/updates.html.
 * The sections of the `pages` entry `updates` (a gold hero), the wave, then
 * the `entries` list and the `pager` in a cream `sec`. Used by
 * src/pages/updates/index.astro (page 1) and
 * src/pages/updates/page/[page].astro (pages 2 and on).
 *
 * Content: the sections come from getPageSections() (src/utils/sections.ts),
 * so a preview link for that entry shows its draft; the list
 * comes from getUpdatesPage(). Every cache hint goes to Astro.cache.set(), on
 * top of the route rule in astro.config.mjs.
 *
 * Missing content (issues.md, C7 notes): with no `updates` page entry the
 * hero holds "Updates" and nothing else. With no published updates the
 * list is the mockup's `empty` box with a short message, and there is no
 * pager; with one page of updates there is no pager either.
 */
import type { CacheHint } from 'emdash';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageSections from './blocks/PageSections.astro';
import SectionDivider from './blocks/SectionDivider.astro';
import { getPageSections } from '../utils/sections';
import EntryList from './EntryList.astro';
import type { EntryItem } from './EntryList.astro';
import { updatesQueryString } from '../utils/updates';
import type { UpdatesQuery } from '../utils/updates';
import '../styles/parts/sec.css';
import '../styles/parts/empty.css';

interface Props {
  items: EntryItem[];
  page: number;
  totalPages: number;
  /** Updates that match the search and filter. */
  total: number;
  /** Projects offered in the filter. */
  projects: { slug: string; title: string }[];
  /** Categories offered in the filter. */
  categories: { slug: string; label: string }[];
  /** The tag the list is narrowed to, if any. */
  tag: { slug: string; label: string } | null;
  query: UpdatesQuery;
  cacheHints: CacheHint[];
}

const { items, page, totalPages, total, projects, categories, tag, query, cacheHints } = Astro.props;

const pageEntry = await getPageSections('updates', { hero: 'gold', fallback: 'Updates' });
const pageHint = pageEntry.cacheHint;
// A search can be any text, so its results are not stored in the cache; the
// filter and sort have a fixed set of values and are cached like the plain list.
if (Astro.cache?.enabled) {
  if (query.q) Astro.cache.set(false);
  else for (const hint of [pageHint, ...cacheHints]) if (hint) Astro.cache.set(hint);
}

const title = pageEntry.title;

const search = updatesQueryString(query);
const narrowed = Boolean(query.q || query.project || query.category || query.tag);
const pageHref = (n: number) => `${n <= 1 ? '/updates/' : `/updates/page/${n}/`}${search}`;
const chosenProject = projects.find((project) => project.slug === query.project);
const chosenCategory = categories.find((category) => category.slug === query.category);
const newer = page > 1 ? pageHref(page - 1) : null;
const older = page < totalPages ? pageHref(page + 1) : null;
---

<BaseLayout
  title={title}
  description={pageEntry.description}
  seo={pageEntry.entry ?? undefined}
  pageNumber={page}
  noindex={narrowed || query.sort === 'oldest'}
  bandFrom="cream"
>
  <PageSections sections={pageEntry.sections} />
  <SectionDivider from={pageEntry.lastTone} to="cream" bands={pageEntry.lastBands} />
  <section class="sec sec--feed">
    <div class="wrap">
      <form class="tools" method="get" action="/updates/" role="search" aria-label="Updates">
        <div class="tools__search">
          <label class="caps" for="updates-q">Search</label>
          <div class="tools__row">
            <input id="updates-q" type="search" name="q" value={query.q} placeholder="Search titles and summaries" maxlength="100" />
            <button class="btn btn--line" type="submit">Search</button>
          </div>
        </div>
        <div class="tools__filters">
          {projects.length > 0 && (
            <div class="tools__field">
              <label class="caps" for="updates-project">Project</label>
              <select id="updates-project" name="project" data-submit-on-change>
                <option value="">All projects</option>
                {projects.map((project) => (
                  <option value={project.slug} selected={project.slug === query.project}>{project.title}</option>
                ))}
              </select>
            </div>
          )}
          {categories.length > 0 && (
            <div class="tools__field">
              <label class="caps" for="updates-category">Category</label>
              <select id="updates-category" name="category" data-submit-on-change>
                <option value="">All categories</option>
                {categories.map((category) => (
                  <option value={category.slug} selected={category.slug === query.category}>{category.label}</option>
                ))}
              </select>
            </div>
          )}
          {query.tag && <input type="hidden" name="tag" value={query.tag} />}
          <div class="tools__field">
            <label class="caps" for="updates-sort">Sort</label>
            <select id="updates-sort" name="sort" data-submit-on-change>
              <option value="newest" selected={query.sort === 'newest'}>Newest</option>
              <option value="oldest" selected={query.sort === 'oldest'}>Oldest</option>
            </select>
          </div>
          <noscript><button class="btn btn--line" type="submit">Apply</button></noscript>
        </div>
      </form>
      {narrowed && (
        <p class="tools__status" role="status">
          {total === 1 ? '1 update' : `${total} updates`}
          {query.q && <> matching “{query.q}”</>}
          {chosenCategory && <> in {chosenCategory.label}</>}
          {tag && <> tagged {tag.label}</>}
          {chosenProject && <> about {chosenProject.title}</>}.
          {' '}<a href={`/updates/${query.sort === 'oldest' ? '?sort=oldest' : ''}`}>Clear</a>
        </p>
      )}
      {items.length > 0 ? (
        <EntryList entries={items} />
      ) : narrowed ? (
        <div class="empty">
          <h3>No updates match</h3>
          <p>Try other words, or another project or category.</p>
        </div>
      ) : (
        <div class="empty">
          <h3>No updates yet</h3>
          <p>News from the projects and the network will be listed here.</p>
        </div>
      )}
      {totalPages > 1 && (
        <nav class="pager" aria-label="Pagination">
          {newer ? (
            <a class="btn btn--line" href={newer} rel="prev">Newer</a>
          ) : (
            <span class="btn btn--line" aria-disabled="true">Newer</span>
          )}
          <span class="caps">Page {page} of {totalPages}</span>
          {older ? (
            <a class="btn btn--line" href={older} rel="next">Older <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
          ) : (
            <span class="btn btn--line" aria-disabled="true">Older</span>
          )}
        </nav>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  // Choosing a project or a sort order applies it at once; without JavaScript
  // the form has an Apply button.
  document.addEventListener('change', (event) => {
    const target = event.target;
    if (target instanceof HTMLSelectElement && target.hasAttribute('data-submit-on-change')) target.form?.requestSubmit();
  });
</script>

<style>
  /* Search, filter and sort: not in the mockups (owner, 2026-11-23). Built
     from the mockups' parts: `caps` labels, the contact form's field look
     (cream-light, `--rule` border, `--radius-sm`) and `btn`. Search on the
     left, the filter and sort on the right; stacked under 760 px. */
  /* The tools sit close under the hero's wave and stay quiet: thin borders,
     no fill, small type (owner, 2026-11-23). */
  .sec--feed {
    padding-top: var(--space-lg);
  }
  .tools {
    display: grid;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
    font-size: var(--text-sm);
  }
  .tools label {
    font-size: var(--text-xs);
  }
  .tools > * {
    min-width: 0;
  }
  .tools__search,
  .tools__field {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.4rem;
  }
  .tools__row {
    display: flex;
    gap: 0.6rem;
  }
  .tools__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: var(--space-md);
  }
  .tools input,
  .tools select {
    height: 2.5rem;
    padding: 0 0.75rem;
    background: transparent;
    color: var(--color-charcoal);
    border: 1px solid rgb(var(--color-charcoal-rgb) / 0.6);
    border-radius: var(--radius-sm);
    font: inherit;
  }
  .tools input {
    flex: 1;
    min-width: 0;
  }
  .tools select {
    flex: 1;
    min-width: 9rem;
  }
  .tools__field {
    flex: 1;
  }
  .tools .btn {
    flex: none;
    height: 2.5rem;
    min-height: 0;
    padding: 0 1.1em;
    border-width: 1px;
    font-size: var(--text-sm);
  }
  .tools__status {
    margin-bottom: var(--space-lg);
    font-size: var(--text-sm);
  }
  .tools__status a {
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-orange);
    text-underline-offset: 0.25em;
  }
  @media (min-width: 760px) {
    .tools {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      gap: var(--space-xl-half);
    }
    .tools__search {
      max-width: 30rem;
    }
    .tools__field {
      flex: none;
    }
    .tools select {
      min-width: 11rem;
    }
  }

  /* Pagination: the `pager` rules in docs/relaunch/mockups/mockups.css
     (only the updates index uses them). */
  .pager {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: var(--rule);
  }

  .pager .btn {
    min-height: 2.75rem;
    padding: 0.5em 1.2em;
    font-size: var(--text-sm);
  }

  .pager .btn svg {
    transition: none;
  }

  .pager [aria-disabled='true'] {
    opacity: 0.45;
    border-style: dashed;
    pointer-events: none;
  }
</style>
