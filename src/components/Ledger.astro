---
/**
 * The "What you get / What it costs" list: the `ledger` rules in
 * src/styles/parts/ledger.css, copied from docs/relaunch/mockups/mockups.css.
 * Each row is a caps label and either a list of short items or one line of
 * text. A row with neither is left out, and so is the whole list when no row
 * has content.
 */
import '../styles/parts/ledger.css';

interface Row {
  label: string;
  items?: string[];
  text?: string;
}

interface Props {
  rows: Row[];
}

const rows = Astro.props.rows
  .map((row) => ({
    ...row,
    items: (row.items ?? []).map((item) => item.trim()).filter(Boolean),
    text: row.text?.trim() ?? '',
  }))
  .filter((row) => row.items.length > 0 || row.text);
---

{rows.length > 0 && (
  <dl class="ledger">
    {rows.map((row) => (
      <div>
        <dt class="caps">{row.label}</dt>
        <dd>
          {row.items.length > 0 ? (
            <ul>{row.items.map((item) => <li>{item}</li>)}</ul>
          ) : (
            row.text
          )}
        </dd>
      </div>
    ))}
  </dl>
)}

<style>
  /* The mockups' base rule is ul { list-style: none }; the site has none. */
  ul {
    list-style: none;
  }
</style>
