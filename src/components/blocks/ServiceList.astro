---
/**
 * Services list: every published `services` entry in its list position, each
 * with who it is for, what you get and its terms. The same fields go out as
 * schema.org Service data (https://schema.org/Service): name, description,
 * serviceType, audience, serviceOutput, termsOfService and the provider.
 */
import { getEmDashCollection } from 'emdash';
import type { BlockComponentProps } from 'emdash/ui';
import type { PageLayoutServiceListBlock } from '../../../emdash-env';
import type { Placed } from '../../utils/sections';
import JsonLd from '../JsonLd.astro';
import Ledger from '../Ledger.astro';
import RichText from '../rich-text/RichText.astro';
import SectionDivider from './SectionDivider.astro';
import '../../styles/parts/sec.css';
import '../../styles/parts/blocks.css';

type Props = BlockComponentProps<PageLayoutServiceListBlock>;
const { value } = Astro.props;
const place = (value as Placed<PageLayoutServiceListBlock>).__place;
const { entries: services, cacheHint } = await getEmDashCollection('services', {
  orderBy: { order: 'asc', created_at: 'asc' },
});
if (Astro.cache?.enabled && cacheHint) Astro.cache.set(cacheHint);
---

{services.length > 0 && (
  <JsonLd
    build={(site) => ({
      '@type': 'ItemList',
      itemListElement: services.map(({ data }, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        item: {
          '@type': 'Service',
          name: data.title,
          description: data.summary,
          serviceType: data.service_type,
          audience: data.audience ? { '@type': 'Audience', audienceType: data.audience } : undefined,
          serviceOutput: (data.deliverables ?? []).map((row) => (row.item ? { '@type': 'Thing', name: row.item } : undefined)),
          termsOfService: data.service_terms,
          url: data.slug ? `${site.url}${Astro.url.pathname}#${data.slug}` : undefined,
          provider: { '@type': 'Organization', name: site.name, url: site.url },
        },
      })),
    })}
  />
)}
<SectionDivider from={place.before} to={place.tone} bands={place.bands} />
<section class="sec">
  <div class="wrap">
    {value.heading && (
      <div class="sec__head">
        <h2 class="display">{value.heading}</h2>
      </div>
    )}
    <div class="blocks">
      {services.map(({ data }) => (
        <article class="block" id={data.slug ?? undefined}>
          <h3>{data.title}</h3>
          <div class="block__main">
            {data.summary && <p class="block__sum">{data.summary}</p>}
            <Ledger
              rows={[
                { label: 'Who it is for', text: data.audience },
                { label: 'What you get', items: (data.deliverables ?? []).map((row) => row.item ?? '') },
                { label: 'Terms', text: data.service_terms },
              ]}
            />
            <RichText value={data.body} inherit />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
