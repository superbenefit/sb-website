---
import { getCollection } from 'astro:content';

const offerings = await getCollection('offerings');
offerings.sort((a, b) => a.data.order - b.data.order);
---

<section id="services" class="offerings-overview">
  <div class="container">
    <span class="section-label" data-animate="fade-up">What We Offer</span>
    <h2 class="section-heading" data-animate="fade-up">
      Services for organizations &amp; ecosystems
    </h2>
    <p class="section-lede" data-animate="fade-up">
      Offerings start as light-touch engagements and scale up to meet
      specific needs. We pull teams from across our networks, with SLAs
      that keep support responsive.
    </p>

    <div class="offerings-list">
      {
        offerings.map((offering, index) => (
          <>
            <div
              class="offering-item"
              data-animate="fade-up"
              style={`--stagger: ${index * 100}ms`}
            >
              <h3 class="offering-heading">{offering.data.title}</h3>
              <p class="offering-body">{offering.data.description}</p>
              <p class="offering-price">{offering.data.price}</p>
            </div>
            {index < offerings.length - 1 && (
              <hr class="offering-rule" aria-hidden="true" />
            )}
          </>
        ))
      }
    </div>

    <footer class="section-footer" data-animate="fade-up">
      <!-- "See all services" hidden until /services page is ready to launch -->
      <a href="/services" class="footer-cta footer-cta-primary" hidden>
        See all services
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14"></path><polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </footer>
  </div>
</section>

<style>
  .offerings-overview {
    background: var(--color-green-sage);
    padding-block: var(--space-xl) var(--space-2xl);
    position: relative;
    overflow: hidden;
  }

  /* ===== Label ===== */
  .section-label {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--color-cream);
    margin-block-end: var(--space-md);
  }

  /* ===== Heading ===== */
  .section-heading {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--color-charcoal);
    line-height: 1.2;
    margin-block-end: var(--space-md);
    max-width: 16ch;
  }

  /* ===== Lede ===== */
  .section-lede {
    font-size: var(--text-base);
    color: var(--color-charcoal);
    line-height: 1.7;
    max-width: 580px;
    margin-block-end: var(--space-xl);
  }

  /* ===== Offerings list — three columns ===== */
  .offerings-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  /* ===== Cream vertical rule between columns ===== */
  .offering-rule {
    display: none;
  }

  /* ===== Offering heading ===== */
  .offering-heading {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    color: var(--color-charcoal);
    line-height: 1.25;
    margin: 0 0 var(--space-sm);
  }

  /* ===== Offering body ===== */
  .offering-body {
    font-size: var(--text-sm);
    color: var(--color-charcoal);
    line-height: 1.7;
    margin: 0;
  }

  /* ===== Offering price ===== */
  .offering-price {
    font-size: var(--text-sm);
    font-weight: 400;
    color: var(--color-charcoal);
    margin: 0;
    margin-block-start: var(--space-md);
    padding-block-start: var(--space-sm);
    border-block-start: 1px solid rgb(var(--color-charcoal-rgb) / 0.1);
  }

  /* ===== Footer CTA ===== */
  .section-footer {
    margin-block-start: var(--space-xl);
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    flex-wrap: wrap;
  }

  .footer-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    transition: opacity var(--transition-fast);
  }

  .footer-cta-primary {
    color: var(--color-cream);
  }

  .footer-cta-primary:hover {
    opacity: 0.7;
  }

  /* ===== Stagger animation delay ===== */
  .offering-item[data-animate] {
    animation-delay: var(--stagger);
  }

  /* ===== Responsive ===== */
  @media (max-width: 768px) {
    .offerings-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .offerings-list {
      grid-template-columns: 1fr;
    }
  }
</style>
