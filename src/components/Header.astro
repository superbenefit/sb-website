---
/**
 * Site header: brand, the "header" menu from EmDash, the menu button and the
 * mobile menu sheet, then the four-colour stripe. Built to the `hd`,
 * `sheet-menu` and `stripe` rules in docs/relaunch/mockups/mockups.css and
 * pages/mobile-menu-open.html.
 *
 * The menu is read with getMenuWithCacheHint() at request time
 * (https://docs.emdashcms.com/guides/menus/). Its cache hint tags the page
 * `emdash:menu:header`, which EmDash purges when the menu is edited, so an
 * edit shows on cached pages too
 * (https://docs.emdashcms.com/deployment/route-caching/). The last item of the menu is shown as the call-to-action
 * pill (desktop) and the full-width button under the list (mobile), as the
 * mockups show for Contact.
 */
import { Image } from 'astro:assets';
import { getMenuWithCacheHint } from 'emdash';
import icon from '../assets/sb-icon.jpg';
import { isNavLinkActive } from '../utils/nav';

interface Props {
  /** Pass the cache hint to Astro.cache; the layout turns it off for pages that are not cached. */
  cache?: boolean;
}

const { cache = true } = Astro.props;
const { data: menu, cacheHint } = await getMenuWithCacheHint('header');
if (cache && Astro.cache?.enabled) Astro.cache.set(cacheHint);
const items = menu?.items ?? [];
const links = items.slice(0, -1);
const cta = items.at(-1);
const currentPath = Astro.url.pathname;
const current = (href: string) => (isNavLinkActive(currentPath, href) ? 'page' : undefined);
const relFor = (target?: string) => (target === '_blank' ? 'noopener noreferrer' : undefined);
---

<header class="hd on-ink">
  <div class="wrap hd__bar">
    <a class="hd__brand" href="/">
      <Image src={icon} alt="" width={36} height={36} densities={[2, 3]} />SuperBenefit
    </a>
    {items.length > 0 && (
      <nav class="hd__nav" aria-label="Main">
        {links.map((item) => (
          <a
            href={item.url}
            target={item.target || undefined}
            rel={relFor(item.target)}
            title={item.titleAttr || undefined}
            aria-current={current(item.url)}
          >
            {item.label}
          </a>
        ))}
        {cta && (
          <a
            class="hd__contact"
            href={cta.url}
            target={cta.target || undefined}
            rel={relFor(cta.target)}
            title={cta.titleAttr || undefined}
            aria-current={current(cta.url)}
          >
            {cta.label}
          </a>
        )}
      </nav>
    )}
    {items.length > 0 && (
      <button class="hd__menu" type="button" aria-expanded="false" aria-controls="site-menu">
        <span class="hd__menu-open">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg> Menu
        </span>
        <span class="hd__menu-close">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg> Close
        </span>
      </button>
    )}
  </div>
  <div class="stripe"></div>
  {items.length > 0 && (
    <nav class="sheet-menu on-ink" id="site-menu" aria-label="Main" hidden>
      <div class="wrap">
        <ul>
          {links.map((item) => (
            <li>
              <a
                href={item.url}
                target={item.target || undefined}
                rel={relFor(item.target)}
                title={item.titleAttr || undefined}
                aria-current={current(item.url)}
              >
                {item.label}
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </a>
            </li>
          ))}
        </ul>
        {cta && (
          <a
            class="btn btn--accent"
            href={cta.url}
            target={cta.target || undefined}
            rel={relFor(cta.target)}
            title={cta.titleAttr || undefined}
            aria-current={current(cta.url)}
          >
            {cta.label}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </a>
        )}
      </div>
    </nav>
  )}
</header>

<script>
  // The header is re-rendered on every page (it is not persisted across view
  // transitions), so the button is wired up again after each navigation.
  const menuParts = () => ({
    button: document.querySelector<HTMLButtonElement>('.hd__menu'),
    sheet: document.getElementById('site-menu'),
  });

  const setOpen = (open: boolean) => {
    const { button, sheet } = menuParts();
    if (!button || !sheet) return;
    button.setAttribute('aria-expanded', String(open));
    sheet.hidden = !open;
  };

  document.addEventListener('astro:page-load', () => {
    const { button } = menuParts();
    if (!button || button.dataset.ready === 'true') return;
    button.dataset.ready = 'true';
    button.addEventListener('click', () => {
      setOpen(button.getAttribute('aria-expanded') !== 'true');
    });
  });

  // Registered once: the module runs a single time, whatever the number of navigations.
  document.addEventListener('keydown', (event) => {
    const { button } = menuParts();
    if (event.key === 'Escape' && button?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      button.focus();
    }
  });
</script>

<style>
  .hd {
    position: relative;
    background: var(--color-black);
    color: var(--color-cream);
  }

  .hd__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: var(--header-height);
  }

  .hd__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
    color: inherit;
  }

  .hd__brand img {
    width: 36px;
    height: 36px;
    border-radius: 50%;
  }

  .hd__nav {
    display: none;
    align-items: center;
    gap: var(--space-xs);
  }

  .hd__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: inherit;
    text-decoration: underline 2px transparent;
    text-underline-offset: 0.5em;
    transition: text-decoration-color var(--transition-fast);
  }

  .hd__nav a:hover,
  .hd__nav a[aria-current='page'] {
    text-decoration-color: var(--color-orange);
  }

  .hd__nav .hd__contact {
    margin-inline-start: var(--space-sm);
    padding-inline: 1.1rem;
    min-height: 2.5rem;
    border-radius: var(--radius-pill);
    background: var(--color-orange);
    color: var(--color-black);
    font-weight: 600;
    text-decoration: none;
  }

  .hd__nav .hd__contact:hover,
  .hd__nav .hd__contact[aria-current='page'] {
    background: var(--color-cream);
  }

  .hd__menu {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 1rem;
    border: 2px solid var(--color-cream);
    border-radius: var(--radius-pill);
    color: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hd__menu > span {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .hd__menu-close,
  .hd__menu[aria-expanded='true'] .hd__menu-open {
    display: none !important;
  }

  .hd__menu[aria-expanded='true'] .hd__menu-close {
    display: inline-flex !important;
  }

  .hd__menu svg {
    width: 1.25em;
    height: 1.25em;
    fill: none;
    stroke: currentcolor;
    stroke-width: 2.25;
    stroke-linecap: round;
  }

  .sheet-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 50;
    background: var(--color-black);
    color: var(--color-cream);
    /* mockups.css gives 780px; the sheet also reaches the foot of the viewport */
    min-height: max(780px, calc(100dvh - var(--header-height) - 12px));
    padding-block: var(--space-lg) var(--space-xl);
  }

  .sheet-menu ul {
    list-style: none;
  }

  .sheet-menu li {
    border-top: 2px solid rgba(237, 221, 200, 0.25);
  }

  .sheet-menu li:last-child {
    border-bottom: 2px solid rgba(237, 221, 200, 0.25);
  }

  .sheet-menu li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.25rem;
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.75rem;
    letter-spacing: -0.01em;
    color: inherit;
  }

  .sheet-menu li a[aria-current='page'] {
    text-decoration: underline 3px var(--color-orange);
    text-underline-offset: 0.3em;
  }

  .sheet-menu li a svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: currentcolor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sheet-menu .btn {
    width: 100%;
    margin-top: var(--space-lg);
  }

  @media (min-width: 1024px) {
    .hd__nav {
      display: flex;
    }

    .hd__menu,
    .sheet-menu {
      display: none;
    }
  }
</style>
