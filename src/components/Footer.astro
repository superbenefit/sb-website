---
/**
 * Site footer: brand, the "footer-site" and "footer-elsewhere" menus from
 * EmDash, the stripe rule and the base line. Built to the `ft` rules in
 * docs/relaunch/mockups/mockups.css. Each menu's label (Site, Elsewhere) is
 * its heading. Menus are read with getMenu() at request time
 * (https://docs.emdashcms.com/guides/menus/).
 *
 * The Elsewhere icons are chosen by the link's host; a link to any other
 * site is shown without an icon.
 */
import { Image } from 'astro:assets';
import { getMenu } from 'emdash';
import icon from '../assets/sb-icon.jpg';
import builtOnEth from '../assets/built-on-ethereum.webp';

const [site, elsewhere] = await Promise.all([getMenu('footer-site'), getMenu('footer-elsewhere')]);
const year = new Date().getFullYear();
const relFor = (target?: string) => (target === '_blank' ? 'noopener noreferrer' : undefined);

const icons: Record<string, string> = {
  discord:
    'M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z',
  x: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  github:
    'M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z',
};

const hostIcons: Record<string, string> = {
  'discord.gg': icons.discord,
  'discord.com': icons.discord,
  'x.com': icons.x,
  'twitter.com': icons.x,
  'github.com': icons.github,
};

function iconFor(url: string): string | undefined {
  if (!URL.canParse(url)) return undefined;
  return hostIcons[new URL(url).hostname.replace(/^www\./, '')];
}
---

<footer class="ft on-ink">
  <div class="wrap ft__wrap">
    <div class="ft__grid">
      <div>
        <a class="ft__brand" href="/">
          <Image src={icon} alt="" width={40} height={40} densities={[2, 3]} />SuperBenefit
        </a>
      </div>
      {site && site.items.length > 0 && (
        <nav aria-label="Footer">
          <h2 class="caps">{site.label}</h2>
          <ul>
            {site.items.map((item) => (
              <li>
                <a
                  href={item.url}
                  target={item.target || undefined}
                  rel={relFor(item.target)}
                  title={item.titleAttr || undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      {elsewhere && elsewhere.items.length > 0 && (
        <nav aria-label="Social">
          <h2 class="caps">{elsewhere.label}</h2>
          <ul>
            {elsewhere.items.map((item) => {
              const path = iconFor(item.url);
              return (
                <li>
                  <a
                    href={item.url}
                    target={item.target || undefined}
                    rel={relFor(item.target)}
                    title={item.titleAttr || undefined}
                  >
                    {path && (
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d={path} />
                      </svg>
                    )}
                    {item.label}
                  </a>
                </li>
              );
            })}
          </ul>
        </nav>
      )}
    </div>
    <div class="stripe stripe--rule"></div>
    <div class="ft__base">
      <p>&copy; {year} SuperBenefit, a Worker Self-Directed Non-Profit Digital LLC</p>
      <a href="https://ethereum.org">
        <Image src={builtOnEth} alt="Built on Ethereum" height={44} densities={[2]} loading="lazy" />
      </a>
    </div>
  </div>
</footer>

<style>
  .ft {
    background: var(--color-black);
    color: var(--color-cream);
  }

  /* Owner decision, 2026-11-22: the footer content spans the window, not the 1200px column of the mockup. */
  .ft__wrap {
    max-width: none;
  }

  .ft__grid {
    display: grid;
    gap: 2.5rem;
    padding-block: var(--space-xl-half);
  }

  .ft__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
    color: var(--color-cream);
    text-decoration: none;
  }

  .ft__brand img {
    width: 40px;
    height: 40px;
    border-radius: 50%;
  }

  .ft h2 {
    margin-bottom: var(--space-sm);
    font-family: var(--font-sans);
    color: rgba(237, 221, 200, 0.75);
  }

  .ft ul {
    list-style: none;
  }

  .ft li a {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    min-height: 2.25rem;
    font-weight: 500;
    color: inherit;
    text-decoration: underline 2px transparent;
    text-underline-offset: 0.35em;
  }

  .ft li a:hover {
    text-decoration-color: var(--color-orange);
  }

  .ft li svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: currentcolor;
    flex: 0 0 auto;
  }

  .ft__base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: 1.5rem;
    font-size: var(--text-sm);
    color: rgba(237, 221, 200, 0.8);
  }

  .ft__base p {
    max-width: none;
  }

  .ft__base img {
    height: 44px;
    width: auto;
  }

  @media (min-width: 900px) {
    .ft__grid {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
      padding-block: 3.5rem 3.75rem;
    }
  }
</style>
