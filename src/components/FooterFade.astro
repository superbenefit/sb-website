---
/**
 * Three charcoal waves fading into the black footer, overlapping the bottom
 * of the section above. The `fade` rules in docs/relaunch/mockups/mockups.css.
 */
---

<div class="fade" aria-hidden="true">
  <svg viewBox="0 0 1440 120" preserveAspectRatio="none">
    <path class="fade-3" d="M0,90 Q720,65 1440,90 L1440,-20 L0,-20 Z" />
    <path class="fade-2" d="M0,60 Q480,35 960,60 Q1440,85 1440,60 L1440,-20 L0,-20 Z" />
    <path class="fade-1" d="M0,30 Q360,5 720,30 Q1080,55 1440,30 L1440,-20 L0,-20 Z" />
  </svg>
</div>

<style>
  .fade {
    height: 80px;
    margin-top: -80px;
    background: var(--color-black);
    line-height: 0;
    overflow: hidden;
    position: relative;
  }

  .fade svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .fade-1 {
    fill: var(--color-charcoal);
  }

  .fade-2 {
    fill: color-mix(in srgb, var(--color-charcoal) 66%, var(--color-black));
  }

  .fade-3 {
    fill: color-mix(in srgb, var(--color-charcoal) 33%, var(--color-black));
  }

  @media (min-width: 769px) {
    .fade {
      height: 120px;
      margin-top: -120px;
    }
  }
</style>
