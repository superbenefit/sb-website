---
/**
 * Portable Text `table` block: EmDash's own Table component, which reads the
 * editor's table format, inside the mockup's `scroll` box, so a wide table
 * scrolls inside the column. The mockup's look (rules between rows, caps
 * header) is applied to EmDash's markup in the PROSE section of
 * src/styles/global.css. The EmDash 1.5.0 table has no caption field.
 *
 * `emdash/ui` 1.5.0 does not export the Table component by name (neither its
 * type declarations nor its runtime entry), so it is taken from
 * `emdashComponents`, the exported map of EmDash's built-in Portable Text
 * renderers.
 *
 * `tabindex="0"` on the `scroll` box: a table wider than the column scrolls
 * sideways, and a scrolling region must be reachable by keyboard (WCAG
 * 2.1.1; axe rule `scrollable-region-focusable`, fixed with a tabindex of 0
 * on the region:
 * https://dequeuniversity.com/rules/axe/4.14/scrollable-region-focusable).
 */
import { emdashComponents } from 'emdash/ui';

const Table = emdashComponents.type.table;

interface Props {
  node: unknown;
}

const { node } = Astro.props;
---

<div class="scroll" tabindex="0"><Table node={node} /></div>
