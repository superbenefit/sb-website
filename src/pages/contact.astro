---
/**
 * Contact page, /contact/: docs/relaunch/mockups/pages/contact.html.
 *
 * Content comes from EmDash on each request (docs/relaunch/architecture.md,
 * Rendering per route): the `pages` entry `contact`, read with
 * getEmDashEntry(), so a draft preview link (`?_preview=`) shows the draft
 * here (https://docs.emdashcms.com/guides/preview/). Its cache hint tags the
 * response for EmDash's purge on publish; the route rule in astro.config.mjs
 * sets the lifetime (https://docs.emdashcms.com/deployment/route-caching/).
 *
 * Fields (seed/seed.json): hero kicker `eyebrow`, title `title`, intro
 * `intro`; the aside's heading `section_heading` and its text `body`, where a
 * last paragraph that is only a link (the mockup's email address) is the
 * `more` link; the closing band's outline button `cta_label` and `cta_url`
 * ("Book an onboarding call", docs/relaunch/issues.md, Decided). The band is
 * the shared widget area in the contact mockup's order: its own link (Join
 * the Discord) leads as the accent button (ClosingBand `lead="band"`).
 *
 * Missing content: an absent entry or field is not rendered; the title falls
 * back to "Contact" so the page always has one h1. The aside is left out when
 * it has no heading and no body; the form is always shown.
 *
 * The form posts to the `contact` action (src/actions/contact.ts). Its states
 * (field error, submitting, success, server error) use the mockup's
 * `field--error`, `field__error`, `btn[aria-disabled]`, `spin` and `banner`
 * rules; the mockups show none of them (docs/relaunch/mockups/README.md).
 */
import { getEmDashEntry } from 'emdash';
import type { PortableTextBlock } from 'emdash';
import RichText from '../components/rich-text/RichText.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import WaveDivider from '../components/WaveDivider.astro';
import '../styles/parts/sec.css';
import '../styles/parts/more.css';

// PUBLIC_ variables are inlined at build time, so the site key is fixed at
// build. It comes from PUBLIC_TURNSTILE_SITE_KEY: `.env` in local
// development, otherwise the `vars` block in wrangler.jsonc. The literal
// below is the production key, as a last fallback.
const siteKey =
  import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '0x4AAAAAADtinm8-q80lFVL-';

const { entry: page, cacheHint } = await getEmDashEntry('pages', 'contact');
if (page && Astro.cache?.enabled) Astro.cache.set(cacheHint);

const data = page?.data;
const title = data?.title || 'Contact';

interface Span {
  _type: string;
  text?: string;
  marks?: string[];
}
type TextBlock = PortableTextBlock & {
  children?: Span[];
  markDefs?: { _type: string; _key: string; href?: string }[];
  style?: string;
};

/** A normal paragraph whose text is all one link: its label and href. */
function linkOnly(block: TextBlock | undefined): { label: string; href: string } | undefined {
  if (!block || block._type !== 'block' || (block.style ?? 'normal') !== 'normal') return undefined;
  const links = (block.markDefs ?? []).filter((def) => def._type === 'link' && def.href);
  if (links.length !== 1) return undefined;
  const [link] = links;
  const spans = (block.children ?? []).filter((child) => (child.text ?? '').trim() !== '');
  if (spans.length === 0 || !spans.every((span) => span.marks?.includes(link._key))) return undefined;
  return { label: spans.map((span) => span.text).join('').trim(), href: link.href as string };
}

const body = (data?.body ?? []) as TextBlock[];
const more = linkOnly(body.at(-1));
const text = more ? body.slice(0, -1) : body;
const hasAside = Boolean(data?.section_heading || body.length);
const bandHref = data?.cta_label && data?.cta_url ? data.cta_url : undefined;
const bandLabel = bandHref ? data?.cta_label : undefined;
---

<BaseLayout
  title={title}
  description={data?.intro || title}
  bandFrom="cream"
  bandLead="band"
  bandLabel={bandLabel}
  bandHref={bandHref}
  preconnect={['https://challenges.cloudflare.com']}
>
  <PageHero title={title} kicker={data?.eyebrow} intro={data?.intro} variant="charcoal" />

  <WaveDivider bg="charcoal" fill="cream" bands />

  <section class="sec">
    <div class="wrap contact">
      {hasAside && (
        <aside class="contact__aside">
          {data?.section_heading && <h2 class="display">{data.section_heading}</h2>}
          <RichText value={text} inherit />
          {more && <a class="more" href={more.href}>{more.label}</a>}
        </aside>
      )}

      <form class="form" id="contact-form" method="POST">
        <div class="field">
          <label for="name">Name (required)</label>
          <input type="text" id="name" name="name" required maxlength="120" autocomplete="name" />
        </div>

        <div class="field">
          <label for="email">Email (required)</label>
          <input type="email" id="email" name="email" required maxlength="200" autocomplete="email" />
        </div>

        <div class="field">
          <label for="subject">Subject (required)</label>
          <input type="text" id="subject" name="subject" required maxlength="200" />
        </div>

        <div class="field">
          <label for="message">Message (required)</label>
          <textarea id="message" name="message" required rows="6" maxlength="5000"></textarea>
        </div>

        <div class="field" data-field="cf-turnstile-response">
          <div id="turnstile-widget" class="form__turnstile" data-sitekey={siteKey}></div>
        </div>

        <button class="btn btn--ink" type="submit">
          Send message
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </button>
      </form>
    </div>
  </section>

  <!-- State markup, copied into the form by the script below. The icons take
       the mockup's `field__error svg`, `banner svg` and `btn svg` rules. -->
  <template id="contact-field-error">
    <p class="field__error">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7.5v5.5M12 16.5v.01" /></svg>
      <span></span>
    </p>
  </template>
  <template id="contact-sending">
    Sending…
    <svg class="spin" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a9 9 0 1 1-9-9" /></svg>
  </template>
  <template id="contact-ok">
    <div class="banner banner--ok" role="status" tabindex="-1">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M8 12.5l2.8 2.8L16.5 9.5" /></svg>
      <p><strong>Message sent.</strong> Thank you. We will be in touch within a few days.</p>
    </div>
  </template>
  <template id="contact-bad">
    <div class="banner banner--bad" role="alert" tabindex="-1">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7.5v5.5M12 16.5v.01" /></svg>
      <p></p>
    </div>
  </template>
</BaseLayout>

<script>
  import { actions, isInputError } from 'astro:actions';

  // Explicit rendering, as Cloudflare recommends for pages reached through
  // client-side navigation:
  // https://developers.cloudflare.com/turnstile/get-started/client-side-rendering/#explicit-rendering
  // This module runs once per visit, so everything that touches the page is
  // done from `astro:page-load`, which <ClientRouter /> fires on the first
  // load and after every navigation:
  // https://docs.astro.build/en/guides/view-transitions/#script-behavior-with-view-transitions
  declare global {
    interface Window {
      turnstile?: {
        render: (
          container: string | HTMLElement,
          options: { sitekey: string; theme?: 'auto' | 'light' | 'dark' },
        ) => string;
        reset: (widgetId: string) => void;
        remove: (widgetId: string) => void;
      };
    }
  }

  let widgetId: string | undefined;

  function renderWidget() {
    const container = document.querySelector<HTMLElement>('#turnstile-widget');
    const sitekey = container?.dataset.sitekey;
    // Not the contact page, the Turnstile script has not loaded yet (the
    // `turnstile:load` event below covers that), or already rendered.
    if (!container || !sitekey || !window.turnstile || widgetId) return;
    widgetId = window.turnstile.render(container, { sitekey, theme: 'light' });
  }

  function removeWidget() {
    if (widgetId && window.turnstile) window.turnstile.remove(widgetId);
    widgetId = undefined;
  }

  // Tokens are single use. After the server has seen one, ask for another.
  function resetWidget() {
    if (widgetId && window.turnstile) window.turnstile.reset(widgetId);
  }

  /** A copy of the content of one of the page's <template> elements. */
  function clone(id: string): DocumentFragment {
    const template = document.getElementById(id);
    return template instanceof HTMLTemplateElement
      ? (template.content.cloneNode(true) as DocumentFragment)
      : document.createDocumentFragment();
  }

  function setupForm() {
    const form = document.querySelector<HTMLFormElement>('#contact-form');
    if (!form || form.dataset.contactInit === 'true') return;
    form.dataset.contactInit = 'true';

    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const idle = submitBtn ? Array.from(submitBtn.childNodes) : [];
    let submitting = false;

    function clearState(f: HTMLFormElement) {
      f.querySelectorAll('.field__error, .banner').forEach((el) => el.remove());
      f.querySelectorAll('.field--error').forEach((el) => el.classList.remove('field--error'));
      f.querySelectorAll('[aria-invalid]').forEach((el) => {
        el.removeAttribute('aria-invalid');
        el.removeAttribute('aria-describedby');
      });
    }

    function showBanner(f: HTMLFormElement, id: 'contact-ok' | 'contact-bad', message?: string) {
      const banner = clone(id).firstElementChild as HTMLElement | null;
      if (!banner) return;
      const p = banner.querySelector('p');
      if (message !== undefined && p) p.textContent = message;
      f.insertBefore(banner, f.firstChild);
      banner.focus();
    }

    function showFieldError(f: HTMLFormElement, field: string, messages: string[]) {
      const wrapper =
        field === 'cf-turnstile-response'
          ? f.querySelector<HTMLElement>('[data-field="cf-turnstile-response"]')
          : f.querySelector(`[name="${CSS.escape(field)}"]`)?.closest<HTMLElement>('.field');
      const error = clone('contact-field-error').firstElementChild as HTMLElement | null;
      if (!wrapper || !error) return;
      error.id = `${field}-error`;
      const span = error.querySelector('span');
      if (span) span.textContent = messages.join(', ');
      wrapper.classList.add('field--error');
      wrapper.appendChild(error);
      const input = wrapper.querySelector('input:not([type="hidden"]), textarea');
      input?.setAttribute('aria-invalid', 'true');
      input?.setAttribute('aria-describedby', error.id);
    }

    function setSubmitting(on: boolean) {
      submitting = on;
      if (!submitBtn) return;
      if (on) {
        submitBtn.replaceChildren(clone('contact-sending'));
        submitBtn.setAttribute('aria-disabled', 'true');
      } else {
        submitBtn.replaceChildren(...idle);
        submitBtn.removeAttribute('aria-disabled');
      }
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitting) return;

      clearState(form);
      setSubmitting(true);

      try {
        const formData = new FormData(form);
        const { data, error } = await actions.contact(formData);

        if (data?.ok) {
          form.reset();
          resetWidget();
          showBanner(form, 'contact-ok');
        } else if (isInputError(error)) {
          for (const [field, messages] of Object.entries(error.fields)) {
            showFieldError(form, field, messages ?? []);
          }
          form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
        } else if (error) {
          showBanner(form, 'contact-bad', error.message);
          resetWidget();
        }
      } finally {
        setSubmitting(false);
      }
    });
  }

  function init() {
    setupForm();
    renderWidget();
  }

  document.addEventListener('astro:page-load', init);
  // Fired by the `onload` callback below when the Turnstile script is ready.
  document.addEventListener('turnstile:load', renderWidget);
  // The old page's widget goes away with its DOM; remove it first.
  document.addEventListener('astro:before-swap', removeWidget);
  // Covers the case where this module first runs after `astro:page-load`.
  init();
</script>

<!-- Turnstile loader with explicit rendering and an onload callback:
     https://developers.cloudflare.com/turnstile/get-started/client-side-rendering/#explicit-rendering
     is:inline so Astro does not bundle either script. The widget adds a
     hidden input named `cf-turnstile-response` to the form on success. -->
<script is:inline>
  window.onTurnstileLoad = function () {
    document.dispatchEvent(new Event('turnstile:load'));
  };
</script>
<script
  src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onTurnstileLoad"
  defer
  is:inline
></script>

<style>
  /* The `contact`, `form`, `field`, `btn[aria-disabled]`, `spin` and `banner`
     rules from docs/relaunch/mockups/mockups.css, unchanged except that the
     design tool's `.is-focus` stand-in is left out and the disabled-button
     selector carries `.form` (see the note on that rule). The state elements come
     from this page's <template>s, so the scoped selectors reach them. The
     Turnstile container keeps the mockup placeholder's 65 px height so the
     form does not move when the widget appears; the widget is not restyled. */
  .contact {
    display: grid;
    gap: var(--space-xl-half);
  }
  .contact__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    align-items: flex-start;
    max-width: 40ch;
  }
  /* The same as the base a rule in global.css (mockups.css `a`: inherit).
     Kept from before global.css's base matched mockups.css (findings.md, G3). */
  .contact__aside .more,
  .contact__aside .more:hover {
    color: inherit;
  }
  .contact__aside h2 {
    font-size: clamp(2rem, 1.5rem + 2vw, 3rem);
    margin-bottom: var(--space-sm);
  }
  .form {
    display: grid;
    gap: 1.25rem;
  }
  .field {
    display: grid;
    gap: 0.4rem;
  }
  .field label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .field input, .field textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 0.9rem;
    background: var(--color-cream-light);
    color: var(--color-charcoal);
    border: var(--rule);
    border-radius: var(--radius-sm);
    font: inherit;
    font-size: var(--text-base);
  }
  .field textarea {
    min-height: 10rem;
    resize: vertical;
  }
  .field input:focus-visible, .field textarea:focus-visible {
    outline: 3px solid var(--color-charcoal);
    outline-offset: 3px;
  }
  .field--error input, .field--error textarea {
    border-color: var(--color-red-deep);
    border-width: 3px;
  }
  .field__error {
    display: flex;
    align-items: center;
    gap: 0.4em;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-red-deep);
  }
  .field__error svg, .banner svg {
    width: 1.2em;
    height: 1.2em;
    flex: 0 0 auto;
    fill: none;
    stroke: currentcolor;
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .form__turnstile {
    min-height: 65px;
    max-width: 100%;
  }
  .form .btn {
    justify-self: start;
    border: 0px;
    cursor: pointer;
    font-family: inherit;
  }
  /* In mockups.css this rule and `.form .btn` tie on specificity, so the
     later one wins. Astro's default "attribute" scoped-style strategy adds the
     scope attribute to each compound selector (scopedStyleStrategy in
     node_modules/astro/dist/core/config/schemas/base.js), which would let
     `.form .btn` win and keep cursor: pointer while sending. Prefixing `.form`
     restores the mockup's outcome; the declarations are unchanged. */
  .form .btn[aria-disabled="true"] {
    opacity: 0.6;
    cursor: progress;
  }
  .spin {
    animation: 1s linear 0s infinite normal none running spin;
  }
  @keyframes spin {
    100% {
      transform: rotate(360deg);
    }
  }
  .banner {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem 1.25rem;
    border: var(--rule);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    line-height: 1.5;
  }
  .banner svg {
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.1em;
  }
  .banner--ok {
    background: var(--color-green-sage);
  }
  .banner--bad {
    background: var(--color-red-deep);
    color: var(--color-cream);
    border-color: var(--color-black);
  }
  @media (min-width: 900px) {
    .contact {
      grid-template-columns: minmax(0px, 5fr) minmax(0px, 7fr);
      gap: var(--space-xl);
      align-items: start;
    }
  }
</style>
