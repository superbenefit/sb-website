---
/**
 * Accelerator page, /accelerator/: docs/relaunch/mockups/pages/accelerator.html.
 *
 * Content: the `pages` entry `accelerator`. The page is its sections (the Sections
 * field, seed/seed.json `blockTypes`), rendered in the editor's order; with
 * no entry the page is a hero holding its name. The closing band's first
 * button repeats the hero's button when it has one.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageSections from '../components/blocks/PageSections.astro';
import { getPageSections } from '../utils/sections';

const page = await getPageSections('accelerator', { hero: 'green', fallback: 'Accelerator' });
if (Astro.cache?.enabled && page.cacheHint) Astro.cache.set(page.cacheHint);
const button = page.hero?.button_label && page.hero.button_url ? page.hero : undefined;
---

<BaseLayout
  title={page.title}
  description={page.description || page.title}
  seo={page.entry ?? undefined}
  bandFrom={page.lastTone}
  bandLabel={button?.button_label ?? undefined}
  bandHref={button?.button_url ?? undefined}
>
  <PageSections sections={page.sections} />
</BaseLayout>
