---
/**
 * Home page, built to docs/relaunch/mockups/pages/home.html.
 *
 * Content: the `pages` entry `home`. Everything on the page is one of its
 * sections (the Sections field, seed/seed.json `blockTypes`): the hero, the
 * about text, the two offer panels, the featured projects and the latest
 * updates. An editor fills, reorders, adds and removes them in the admin.
 * Each section component sets its own cache hint, so a publish in a collection
 * it reads purges the page
 * (https://docs.emdashcms.com/deployment/route-caching/); the route rule for
 * `/` in astro.config.mjs carries the same collection tags.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageSections from '../components/blocks/PageSections.astro';
import { getPageSections } from '../utils/sections';
import '../styles/home.css';

const page = await getPageSections('home', { hero: 'home', fallback: 'Home' });
if (Astro.cache?.enabled && page.cacheHint) Astro.cache.set(page.cacheHint);

// Head title (owner, 2026-11-24): "SuperBenefit — Make Better Faster", the
// site name then the byline. An SEO panel title on the home entry replaces
// the byline (BaseLayout, getSeoMeta()).
const pageTitle = 'Make Better Faster';
---

<BaseLayout title={pageTitle} description={page.description} seo={page.entry ?? undefined} siteFirst bandFrom={page.lastTone}>
  <PageSections sections={page.sections} />
</BaseLayout>
