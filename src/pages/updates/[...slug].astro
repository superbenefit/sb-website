---
/**
 * An update: docs/relaunch/mockups/pages/update.html. Compact gold hero with
 * "Update", the date and the byline, then the article column: the excerpt as
 * the lead, the cover, the body (RichText, C2) and the end block with the
 * linked project's card and the link back to the index.
 *
 * Rendered on demand and cached under the `/updates/[...slug]` route rule
 * (docs/relaunch/architecture.md, Rendering per route, Caching). The entry
 * and its `project` reference come from one getEmDashEntry() call
 * (`references`, https://docs.emdashcms.com/guides/querying-content/), so a
 * preview link shows the draft, and its cache hint also names the project it
 * shows. The date is the entry's `publishedAt`; the author is EmDash's
 * bylines (`data.bylines`, hydrated by the query; emdash 1.5.0
 * src/query.ts).
 *
 * Missing content (issues.md, C7 notes): no date, byline, excerpt, cover,
 * body or project, no element for it. The end block always keeps the link
 * to all updates.
 */
import { getEmDashEntry } from 'emdash';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import WaveDivider from '../../components/WaveDivider.astro';
import ImageSlot from '../../components/ImageSlot.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import RichText from '../../components/rich-text/RichText.astro';
import { bylineNames, formatUpdateDate } from '../../utils/updates';
import '../../styles/parts/sec.css';
import '../../styles/parts/more.css';

const slug = Astro.params.slug?.replace(/\/+$/, '');
if (!slug) {
  return Astro.rewrite('/404');
}
const { entry: update, cacheHint, error } = await getEmDashEntry('updates', slug, {
  references: { project: true },
});
if (error) console.error(`[updates] entry ${slug}:`, error);
if (!update) {
  return Astro.rewrite('/404');
}
// Tags the response with this entry and its project, so publishing either
// purges the cached page (B6, #33).
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { data } = update;
const title = data.title || 'Update';
const date = data.publishedAt;
const author = bylineNames(data.bylines);
const project = update.references?.project.entries[0] ?? null;
---

<BaseLayout
  title={title}
  description={data.excerpt ?? ''}
  seo={update}
  type="article"
  publishedAt={date ?? undefined}
  dateModified={data.updatedAt}
  authorName={author ?? undefined}
  bandFrom="cream"
>
  <PageHero title={title} variant="gold" compact>
    <Fragment slot="meta">
      <span class="caps">Update</span>
      {date && <span class="caps"><time datetime={date.toISOString()}>{formatUpdateDate(date)}</time></span>}
      {author && <span class="caps">By {author}</span>}
    </Fragment>
  </PageHero>
  <WaveDivider bg="gold" fill="cream" />
  <section class="sec">
    <div class="wrap">
      <article class="article">
        {data.excerpt && <p class="article__lead">{data.excerpt}</p>}
        {data.cover && (
          <div class="article__cover">
            <ImageSlot image={data.cover} />
          </div>
        )}
        <RichText value={data.body} />
        <div class="article__end">
          {project && (
            <>
              <p class="caps">About the project</p>
              <ProjectCard project={project} coverRatio="3 / 1" />
            </>
          )}
          <a class="more" href="/updates/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6" /></svg> All updates</a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  /* Update article layout: the `article` rules in
     docs/relaunch/mockups/mockups.css (only this page uses them). */
  .article {
    max-width: 47.5rem;
    margin-inline: auto;
  }

  .article__lead {
    font-size: clamp(1.25rem, 1.1rem + 0.7vw, 1.5rem);
    line-height: 1.5;
    margin-bottom: var(--space-lg);
  }

  .article__cover {
    aspect-ratio: 16 / 9;
    border: var(--rule);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-xl-half);
  }

  .article__cover :global(.slot) {
    background: var(--color-cream-light);
  }

  /* `contain: size` keeps a real cover's own height out of the frame's size,
     so the frame's aspect-ratio alone sets its height, as with the
     placeholder (https://developer.mozilla.org/en-US/docs/Web/CSS/contain);
     the same rule as the project card's cover in ProjectCard.astro. */
  .article__cover :global(.has-image) {
    contain: size;
  }

  .article__end {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: var(--rule);
  }

  /* The same as the base a rule in global.css (mockups.css `a`: inherit).
     Kept from before global.css's base matched mockups.css (findings.md, G3). */
  .more,
  .more:hover {
    color: inherit;
  }
</style>
