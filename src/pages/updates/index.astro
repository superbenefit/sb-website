---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogList from '../../components/BlogList.astro';
import PageHero from '../../components/PageHero.astro';
import WaveDivider from '../../components/WaveDivider.astro';
import { getCollection } from 'astro:content';

// Rendered on demand (docs/relaunch/architecture.md, Rendering per route).
// A second dynamic route beside [...slug].astro would collide in on-demand
// mode, so this file is /updates/ and shows the newest entries only; the
// paginated index is C7's. The list still reads the legacy `updates`
// collection until C7 and B7, and production shows the draft placeholder.
const pageSize = 10;
const allPosts = (await getCollection('updates', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
const posts = allPosts.slice(0, pageSize);

// Draft mode: page renders fully in dev, "Coming soon" placeholder in production.
// Toggle by flipping `pageIsDraft` to false when the page is ready to ship.
const pageIsDraft = true;
const showDraftPlaceholder = pageIsDraft && import.meta.env.PROD;

const hero = {
  title: 'Updates',
  subtitle: 'Notes on governance, DAOs, and the frontiers of systems innovation',
};
---

<BaseLayout
  title="Updates — SuperBenefit"
  description="Notes on governance, DAOs, web3, and building a better world through systems innovation."
  noindex={showDraftPlaceholder}
>
  {showDraftPlaceholder ? (
    <section class="draft-placeholder">
      <div class="container">
        <span class="section-label">Draft</span>
        <h1>Coming soon</h1>
        <p>We're working on this page. Check back soon.</p>
        <a href="/" class="draft-cta">Back to home</a>
      </div>
    </section>
  ) : (
    <>
      <PageHero title={hero.title} intro={hero.subtitle} variant="gold" />

  <WaveDivider bg="gold" fill="cream" />

  <section class="updates-content">
    <div class="container">
      <BlogList posts={posts} />
    </div>
  </section>

    </>
  )}
</BaseLayout>

<style>
  /* ===== Draft placeholder (production only, when pageIsDraft === true) ===== */
  .draft-placeholder {
    background: var(--color-cream);
    padding-block: var(--space-2xl);
    min-height: 60vh;
    display: flex;
    align-items: center;
    text-align: center;
  }
  .draft-placeholder .container {
    max-width: 640px;
  }
  .draft-placeholder .section-label {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-orange);
    margin-block-end: var(--space-sm);
  }
  .draft-placeholder h1 {
    font-family: var(--font-serif);
    color: var(--color-charcoal);
    margin-block-end: var(--space-md);
  }
  .draft-placeholder p {
    color: var(--color-charcoal);
    opacity: 0.8;
    font-size: var(--text-lg);
    line-height: 1.7;
    margin-block-end: var(--space-xl);
  }
  .draft-cta {
    display: inline-block;
    padding: 0.9em 2em;
    border-radius: 50px;
    background: var(--color-orange);
    color: var(--color-cream);
    font-weight: 600;
    text-decoration: none;
    transition: background var(--transition-fast);
  }
  .draft-cta:hover {
    background: var(--color-orange-dark);
  }

  .updates-content {
    background: var(--color-cream);
    padding-block: var(--space-2xl);
  }
</style>
