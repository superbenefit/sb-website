---
import UpdatesIndex from '../../components/UpdatesIndex.astro';
import { getUpdatesPage } from '../../utils/updates';

// The updates index, page 1 (docs/relaunch/mockups/pages/updates.html).
// Rendered on demand and cached under the `/updates` route rule
// (docs/relaunch/architecture.md, Rendering per route, Caching). Later pages
// are /updates/page/{n}/ (src/pages/updates/page/[page].astro).
const data = await getUpdatesPage(1);
---

<UpdatesIndex items={data.items} page={1} totalPages={data.totalPages} cacheHints={data.cacheHints} />
