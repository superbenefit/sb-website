---
/**
 * Not found (docs/relaunch/mockups/pages/not-found.html). Astro renders this
 * page, with status 404, for any URL that matches no route
 * (https://docs.astro.build/en/basics/astro-pages/#custom-404-error-page).
 * The copy is in code (docs/relaunch/architecture.md, Rendering per route).
 * Not cached, no canonical, no closing band.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ErrorPage from '../components/ErrorPage.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page Not Found — SuperBenefit" description="The page you were looking for doesn't exist." canonical={null} closingBand={false} cache={false}>
  <ErrorPage code={404} title="Page not found" message="The page you were looking for has moved, been removed, or never existed.">
    <Button href="/" arrow>Go home</Button>
    <Button href="/updates/" variant="line">Browse updates</Button>
  </ErrorPage>
</BaseLayout>
