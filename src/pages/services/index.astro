---
/**
 * Services page, /services/: docs/relaunch/mockups/pages/services.html.
 *
 * Content comes from EmDash on each request (docs/relaunch/architecture.md,
 * Rendering per route): the `pages` entry `services` and the `services`
 * collection. Both queries go through EmDash's helpers, so a draft preview
 * link (`?_preview=`) for the page or for a service shows the draft here
 * (https://docs.emdashcms.com/guides/preview/). Their cache hints tag the
 * response `pages` and `services` for EmDash's purge on publish; the route
 * rule in astro.config.mjs sets the lifetime
 * (https://docs.emdashcms.com/deployment/route-caching/).
 *
 * Fields (seed/seed.json): hero kicker `eyebrow`, title `title`, intro
 * `intro`, hero button `cta_label` and `cta_url` (rendered only when
 * `cta_url` is filled; the same label and link are the closing band's first
 * button, which otherwise is the layout's default), and the "How it works"
 * split from `section_label`, `section_heading` and `body`. Each service is
 * a block: `title`, then the ledger of `audience` ("Who it is for"),
 * `deliverables` (a repeater, sub-field `item`: "What you get") and
 * `service_terms` ("Terms"), shown with the shared `Ledger` component, then
 * `body`; ordered by `order`.
 *
 * Missing content: an absent entry or field is not rendered; the title falls
 * back to "Services" so the page always has one h1. The split is left out
 * when it has no label, heading or body, and the waves join the sections
 * that remain. A service with none of the three ledger fields has no ledger.
 * With no published services the section shows a one-line notice in a
 * `block`.
 */
import { getEmDashCollection, getEmDashEntry } from 'emdash';
import RichText from '../../components/rich-text/RichText.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import Ledger from '../../components/Ledger.astro';
import PageHero from '../../components/PageHero.astro';
import WaveDivider from '../../components/WaveDivider.astro';
import '../../styles/parts/sec.css';
import '../../styles/parts/split.css';
import '../../styles/parts/blocks.css';

const { entry: page, cacheHint: pageHint } = await getEmDashEntry('pages', 'services');
const { entries: services, cacheHint: servicesHint } = await getEmDashCollection('services', {
  orderBy: { order: 'asc', created_at: 'asc' },
});
if (Astro.cache?.enabled) {
  Astro.cache.set(pageHint);
  Astro.cache.set(servicesHint);
}

const data = page?.data;
const title = data?.title || 'Services';
const ctaUrl = data?.cta_url;
const ctaLabel = data?.cta_label || 'Ask about a service';
const hasBody = Boolean(data?.body?.length);
const hasSplit = Boolean(data?.section_label || data?.section_heading || hasBody);
---

<BaseLayout
  title={title}
  description={data?.intro || title}
  bandLabel={ctaUrl ? ctaLabel : undefined}
  bandHref={ctaUrl || undefined}
  bandFrom="cream"
>
  {/* Two branches, so PageHero gets no `actions` slot at all when there is
      no button and renders no empty actions row. */}
  {ctaUrl ? (
    <PageHero title={title} kicker={data?.eyebrow} intro={data?.intro} variant="orange">
      <Fragment slot="actions"><Button href={ctaUrl} variant="ink" arrow>{ctaLabel}</Button></Fragment>
    </PageHero>
  ) : (
    <PageHero title={title} kicker={data?.eyebrow} intro={data?.intro} variant="orange" />
  )}

  {hasSplit ? (
    <>
      <WaveDivider bg="orange" fill="charcoal" />
      <section class="sec sec--ink on-ink">
        <div class="wrap split">
          <div>
            {data?.section_label && <p class="caps">{data.section_label}</p>}
            {data?.section_heading && <h2 class="display">{data.section_heading}</h2>}
          </div>
          {hasBody && (
            <div class="split__body">
              <RichText value={data?.body} inherit />
            </div>
          )}
        </div>
      </section>
      <WaveDivider bg="charcoal" fill="cream" />
    </>
  ) : (
    <WaveDivider bg="orange" fill="cream" />
  )}

  <section class="sec">
    <div class="wrap">
      <div class="sec__head">
        <h2 class="display">What we offer</h2>
      </div>
      <div class="blocks">
        {services.length > 0 ? (
          services.map((service) => {
            const { audience, service_terms: terms, body } = service.data;
            const deliverables = (service.data.deliverables ?? []).map((d) => d.item ?? '');
            return (
              <article class="block">
                <h3>{service.data.title}</h3>
                <div class="block__main">
                  <Ledger
                    rows={[
                      { label: 'Who it is for', text: audience },
                      { label: 'What you get', items: deliverables },
                      { label: 'Terms', text: terms },
                    ]}
                  />
                  <RichText value={body} inherit />
                </div>
              </article>
            );
          })
        ) : (
          <div class="block">
            <p class="block__sum">No services are published yet.</p>
          </div>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

