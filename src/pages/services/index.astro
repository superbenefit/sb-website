---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import ServicesSection from '../../components/ServicesSection.astro';
import OfferingCards from '../../components/OfferingCards.astro';
import ClientLogos from '../../components/ClientLogos.astro';
import CallToAction from '../../components/CallToAction.astro';

const hero = {
  title: 'Services',
  subtitle: 'Community, co-stewardship, and development for aligned organizations and ecosystems',
  overlayGradient: `linear-gradient(
    to bottom,
    color-mix(in srgb, var(--color-green-sage) 30%, transparent) 0%,
    color-mix(in srgb, var(--color-charcoal) 70%, transparent) 50%,
    color-mix(in srgb, var(--color-black) 95%, transparent) 100%
  )`,
  showStars: true,
};

// Draft mode: page renders fully in dev, "Coming soon" placeholder in production.
// Toggle by flipping `pageIsDraft` to false when the page is ready to ship.
const pageIsDraft = true;
const showDraftPlaceholder = pageIsDraft && import.meta.env.PROD;
---

<BaseLayout
  title="Services — SuperBenefit"
  description="Community sensemaking, project co-stewardship, and digital commons development for organizations and ecosystems working on regenerative coordination."
  noindex={showDraftPlaceholder}
>
  {showDraftPlaceholder ? (
    <section class="draft-placeholder">
      <div class="container">
        <span class="section-label">Draft</span>
        <h1>Coming soon</h1>
        <p>We're working on this page. Check back soon.</p>
        <a href="/" class="draft-cta">Back to home</a>
      </div>
    </section>
  ) : (
    <>
      <PageHero {...hero} />

      <SectionDivider from="black" to="cream" />

      {/* Lede */}
      <section class="services-lede" aria-labelledby="lede-heading">
        <div class="container" data-animate="fade-up">
          <span class="section-label">How We Work</span>
          <h2 id="lede-heading">
            We support organizations and ecosystems that are building new
            systems of coordination.
          </h2>
          <p>
            Every engagement is collaborative: we learn as much as we share. Our
            offerings scale from light-touch community access to embedded
            co-stewardship and purpose-fit digital tools.
          </p>
        </div>
        <div class="container client-logos-row" data-animate="fade-up">
          <span class="section-label client-logos-label">Trusted by</span>
          <h2 class="visually-hidden">Organizations we've worked with</h2>
          <ClientLogos />
        </div>
      </section>

      <SectionDivider from="cream" to="charcoal" />

      <ServicesSection />

      <SectionDivider from="charcoal" to="green" />

      <OfferingCards />

      <SectionDivider from="green" to="charcoal" />

      <CallToAction />
    </>
  )}
</BaseLayout>

<style>
  /* ===== Draft placeholder (production only, when pageIsDraft === true) ===== */
  .draft-placeholder {
    background: var(--color-cream);
    padding-block: var(--space-2xl);
    min-height: 60vh;
    display: flex;
    align-items: center;
    text-align: center;
  }
  .draft-placeholder .container {
    max-width: 640px;
  }
  .draft-placeholder h1 {
    font-family: var(--font-serif);
    color: var(--color-charcoal);
    margin-block-end: var(--space-md);
  }
  .draft-placeholder p {
    color: var(--color-charcoal);
    opacity: 0.8;
    font-size: var(--text-lg);
    line-height: 1.7;
    margin-block-end: var(--space-xl);
  }
  .draft-cta {
    display: inline-block;
    padding: 0.9em 2em;
    border-radius: 50px;
    background: var(--color-orange);
    color: var(--color-cream);
    font-weight: 600;
    text-decoration: none;
    transition: background var(--transition-fast);
  }
  .draft-cta:hover {
    background: var(--color-orange-dark);
  }

  /* ===== Section label ===== */
  .section-label {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-orange);
    margin-block-end: var(--space-sm);
  }

  /* ===== Lede ===== */
  .services-lede {
    background: var(--color-cream);
    padding-block-start: var(--space-lg);
    padding-block-end: var(--space-2xl);
  }

  .services-lede h2 {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    color: var(--color-charcoal);
    line-height: 1.2;
    margin-block-end: var(--space-lg);
    max-width: 28ch;
  }

  .services-lede p {
    color: var(--color-charcoal);
    opacity: 0.8;
    font-size: var(--text-lg);
    line-height: 1.7;
    max-width: 60ch;
  }

  /* ===== Client logos row (inside lede) ===== */
  .client-logos-row {
    margin-block-start: var(--space-lg);
  }

  .client-logos-label {
    display: block;
    text-align: center;
    font-size: 0.7rem;
    color: rgb(var(--color-charcoal-rgb) / 0.5);
    margin-block-end: var(--space-xs);
  }

  @media (max-width: 480px) {
    .client-logos-row {
      padding-inline: var(--space-sm);
    }

    .services-lede {
      padding-block: var(--space-xl) 6rem;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
