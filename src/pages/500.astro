---
/**
 * Server error (docs/relaunch/mockups/pages/server-error.html). Astro renders
 * this page, with status 500, when an on-demand page throws
 * (https://docs.astro.build/en/basics/astro-pages/#custom-500-error-page). The
 * `error` prop it receives is not shown to visitors. The copy is in code
 * (docs/relaunch/architecture.md, Rendering per route). Not cached, no
 * canonical, no closing band.
 *
 * "Try again" loads the requested URL again as a full page load
 * (`data-astro-reload`, https://docs.astro.build/en/guides/view-transitions/#preventing-client-side-navigation).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ErrorPage from '../components/ErrorPage.astro';
import Button from '../components/Button.astro';

const retryHref = `${Astro.url.pathname}${Astro.url.search}`;
---

<BaseLayout title="Server Error — SuperBenefit" description="Something went wrong on our end. Please try again." canonical={null} closingBand={false} cache={false}>
  <ErrorPage code={500} title="Something went wrong" message="We encountered an unexpected error. Please try again in a moment, or head back home.">
    <Button href="/" arrow>Go home</Button>
    <Button href={retryHref} variant="line" data-astro-reload>Try again</Button>
  </ErrorPage>
</BaseLayout>
