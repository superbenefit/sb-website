---
/**
 * Base layout for every public page: head tags from <EmDashHead>, then the
 * header, the page, the closing band, the fade and the footer
 * (docs/relaunch/mockups/). Header and footer menus and the closing band are
 * read from EmDash on each request, so pages using this layout render on
 * demand (docs/relaunch/architecture.md, Rendering per route).
 *
 * Head: the page context is built with createPublicPageContext() and passed
 * to <EmDashHead>, which writes the description, canonical, Open Graph and
 * Twitter tags and the JSON-LD (WebSite for pages, BlogPosting for
 * articles), applies the site's staging noindex and any plugin metadata, and
 * escapes it all (https://docs.emdashcms.com/guides/seo/,
 * https://docs.emdashcms.com/guides/site-settings/; emdash 1.5.0
 * src/components/EmDashHead.astro). The <title> stays the layout's.
 */
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import { getSiteSettings } from 'emdash';
import { createPublicPageContext } from 'emdash/page';
import { EmDashHead } from 'emdash/ui';
// Global styles first, so component styles come after them in the cascade.
import '../styles/global.css';
import '../styles/animations.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FooterFade from '../components/FooterFade.astro';
import ClosingBand from '../components/ClosingBand.astro';

type BandFrom = 'black' | 'charcoal' | 'cream' | 'paper' | 'green' | 'orange' | 'gold' | 'red';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  bodyClass?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  noindex?: boolean;
  authorName?: string;
  coverImage?: string;
  dateModified?: Date;
  /** Canonical URL; defaults to this page's path. `null` writes none (error pages). */
  canonical?: string | null;
  /**
   * Origins to preconnect to from the document <head>. Should be limited to
   * pages that actually fetch resources from these origins.
   */
  preconnect?: string[];
  /** Closing band at the foot of the page; the error pages turn it off. */
  closingBand?: boolean;
  /** Background of the last section, for the wave into the band. */
  bandFrom?: BandFrom;
  /** The band's first button; defaults to "Get in touch" and /contact/. */
  bandLabel?: string;
  bandHref?: string;
}

const {
  title,
  description,
  ogImage = '/images/brand-showcase.webp',
  bodyClass = '',
  type = 'website',
  publishedAt,
  noindex = false,
  authorName,
  coverImage,
  dateModified,
  canonical,
  preconnect = [],
  closingBand = true,
  bandFrom,
  bandLabel,
  bandHref,
} = Astro.props;

const settings = await getSiteSettings();
const siteName = settings.title || 'SuperBenefit';
const siteUrl = (settings.url || Astro.url.origin).replace(/\/$/, '');
const fullTitle = title.includes(siteName) ? title : `${title} — ${siteName}`;

// Internal links end in "/" (architecture.md, Stack), so the canonical does too.
const path = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/+$/, '')}/`;
const canonicalUrl = canonical === null ? null : (canonical ?? `${siteUrl}${path}`);
const image = new URL(coverImage ?? ogImage, `${siteUrl}/`).href;

const page = createPublicPageContext({
  Astro,
  kind: 'custom',
  pageType: type,
  title: fullTitle,
  pageTitle: title,
  description,
  canonical: canonicalUrl,
  image,
  seo: noindex ? { robots: 'noindex, nofollow' } : undefined,
  articleMeta:
    type === 'article'
      ? {
          publishedTime: publishedAt?.toISOString() ?? null,
          modifiedTime: dateModified?.toISOString() ?? null,
          author: authorName ?? null,
        }
      : undefined,
  siteName,
  siteUrl,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <EmDashHead page={page} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <meta name="theme-color" content="#1a1a1a" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="sitemap" href="/sitemap.xml" />
    {preconnect.map((origin) => <link rel="preconnect" href={origin} />)}
    <Font cssVariable="--font-playfair" preload />
    <Font cssVariable="--font-inter" preload />
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <Header />
    <main>
      <slot />
      {closingBand && <ClosingBand from={bandFrom} primaryLabel={bandLabel} primaryHref={bandHref} />}
    </main>
    <FooterFade />
    <Footer />
    <script>
      // Scroll to the #fragment after a view-transition navigation, which
      // ClientRouter does not always do on its own.
      function scrollToHash() {
        const hash = window.location.hash;
        if (hash) {
          const el = document.querySelector(hash);
          if (el) {
            setTimeout(() => {
              el.scrollIntoView({ behavior: 'smooth' });
            }, 100);
          }
        }
      }
      document.addEventListener('astro:after-swap', scrollToHash);
      scrollToHash();
    </script>
  </body>
</html>
