---
/**
 * Base layout for every public page: head tags from <EmDashHead>, then the
 * header, the page, the closing band, the fade and the footer
 * (docs/relaunch/mockups/). Header and footer menus and the closing band are
 * read from EmDash on each request, so pages using this layout render on
 * demand (docs/relaunch/architecture.md, Rendering per route).
 *
 * Head: the page context is built with createPublicPageContext() and passed
 * to <EmDashHead>, which writes the description, canonical, Open Graph and
 * Twitter tags and the JSON-LD (WebSite for pages, BlogPosting for
 * articles), applies the site's staging noindex and any plugin metadata, and
 * escapes it all (https://docs.emdashcms.com/guides/seo/,
 * https://docs.emdashcms.com/guides/site-settings/; emdash 1.5.0
 * src/components/EmDashHead.astro). The <title> stays the layout's.
 *
 * Title, description and canonical (D6): a page that renders an entry passes
 * it as `seo`, and getSeoMeta() resolves the SEO panel's title, description
 * and canonical first, then the page's `title` and `description` (built from
 * the entry's own fields, else fixed text), as the SEO guide documents
 * (emdash 1.5.0 src/seo/index.ts). The <title> is "{page title} — {site
 * name}"; `siteFirst` (home) puts the site name first and uses the whole
 * title for og:title. `pageNumber` above 1 (a later page of a list) adds
 * ", page n" to the title and "Page n." before the description, and keeps
 * the canonical on the page's own URL, since the entry's panel belongs to
 * page 1. `term` (home: "Nonprofit DAO Accelerator") must be in the title:
 * a resolved title without it (an SEO panel title, say) becomes
 * "{term} — {title}", so the panel title is used and the term stays. With
 * no description at all, the full title stands in.
 * The panel's image is the share image (else `coverImage`, else the site
 * default) and its "Hide from search engines" writes `noindex, nofollow`
 * (getSeoMeta's `ogImage` and `robots`). The separator is Settings > SEO
 * "Title separator", else " — ". Absolute URLs use the Settings site URL,
 * then EMDASH_SITE_URL, then the request origin.
 *
 * Caching (docs/relaunch/architecture.md, Caching;
 * https://docs.emdashcms.com/deployment/route-caching/): the route rule in
 * astro.config.mjs sets the lifetime and the collection tags. The layout and
 * its parts add the cache hints of what they read (site settings, the three
 * menus, the closing band), so EmDash's purge on a settings, menu or widget
 * edit reaches every cached page. `cache={false}` (error pages) opts the
 * response out with Astro.cache.set(false) and keeps the parts from setting
 * hints after it, because a later set() turns caching back on.
 */
import { ClientRouter } from 'astro:transitions';
import { Font } from 'astro:assets';
import { getSeoMeta, getSiteSettingsWithCacheHint } from 'emdash';
import { createPublicPageContext } from 'emdash/page';
import { EmDashHead } from 'emdash/ui';
// Global styles first, so component styles come after them in the cascade.
import '../styles/global.css';
import '../styles/animations.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FooterFade from '../components/FooterFade.astro';
import ClosingBand from '../components/ClosingBand.astro';
import { envSiteUrl } from '../utils/sitemap';

type BandFrom = 'black' | 'charcoal' | 'cream' | 'paper' | 'green' | 'orange' | 'gold' | 'red';

interface Props {
  /** Page title, without the site name: the entry's own title, else fixed text. */
  title: string;
  /** The entry's own description field, else fixed text; may be empty. */
  description: string;
  /** The entry this page renders: its SEO panel title, description and canonical win. */
  seo?: Parameters<typeof getSeoMeta>[0];
  /** Site name first in the <title>, and the whole title as og:title (home). */
  siteFirst?: boolean;
  /** Page of a paginated list; above 1 the title and description name it. */
  pageNumber?: number;
  /** Words the title must carry; put before a resolved title that lacks them (home). */
  term?: string;
  ogImage?: string;
  bodyClass?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  noindex?: boolean;
  authorName?: string;
  coverImage?: string;
  dateModified?: Date;
  /** Canonical URL; defaults to this page's path. `null` writes none (error pages). */
  canonical?: string | null;
  /**
   * Origins to preconnect to from the document <head>. Should be limited to
   * pages that actually fetch resources from these origins.
   */
  preconnect?: string[];
  /** Closing band at the foot of the page; the error pages turn it off. */
  closingBand?: boolean;
  /** Background of the last section, for the wave into the band. */
  bandFrom?: BandFrom;
  /** The band's first button; defaults to "Get in touch" and /contact/. */
  bandLabel?: string;
  bandHref?: string;
  /** `band`: the band's own link leads and the page's button follows (contact). */
  bandLead?: 'page' | 'band';
  /** Cache this response under the route rule; `false` for error pages. */
  cache?: boolean;
}

const {
  title: fallbackTitle,
  description: fallbackDescription,
  seo,
  siteFirst = false,
  pageNumber = 1,
  term,
  ogImage = '/images/brand-showcase.webp',
  bodyClass = '',
  type = 'website',
  publishedAt,
  noindex = false,
  authorName,
  coverImage,
  dateModified,
  canonical,
  preconnect = [],
  closingBand = true,
  bandFrom,
  bandLabel,
  bandHref,
  bandLead,
  cache = true,
} = Astro.props;

const { data: settings, cacheHint: settingsHint } = await getSiteSettingsWithCacheHint();
if (Astro.cache?.enabled) Astro.cache.set(cache ? settingsHint : false);
const siteName = settings.title || 'SuperBenefit';
// Site URL in the SEO guide's order: Settings, then EMDASH_SITE_URL, then the request origin.
const siteUrl = (settings.url || envSiteUrl() || Astro.url.origin).replace(/\/$/, '');
// Settings > SEO "Title separator", else the site's " — ".
const separator = settings.seo?.titleSeparator || ' — ';

// Internal links end in "/" (architecture.md, Stack), so the canonical does too.
const path = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/+$/, '')}/`;

// SEO panel first, then the page's own values (https://docs.emdashcms.com/guides/seo/).
const meta = seo
  ? getSeoMeta(seo, {
      siteUrl,
      path,
      defaultTitle: fallbackTitle || undefined,
      defaultDescription: fallbackDescription || undefined,
    })
  : undefined;
const later = pageNumber > 1;
const resolvedTitle = meta?.title || fallbackTitle;
const termedTitle =
  term && !resolvedTitle.toLowerCase().includes(term.toLowerCase()) ? `${term}${separator}${resolvedTitle}` : resolvedTitle;
const title = `${termedTitle}${later ? `, page ${pageNumber}` : ''}`;
const fullTitle = title.includes(siteName)
  ? title
  : siteFirst
    ? `${siteName}${separator}${title}`
    : `${title}${separator}${siteName}`;
const ownDescription = meta?.description || fallbackDescription;
const description = later ? `Page ${pageNumber}. ${ownDescription || fullTitle}` : ownDescription || fullTitle;
const canonicalUrl =
  canonical === null ? null : (canonical ?? ((!later && meta?.canonical) || `${siteUrl}${path}`));
// Share image: the SEO panel's image, then the page's own, then the site default.
const image = new URL(meta?.ogImage || coverImage || ogImage, `${siteUrl}/`).href;
// "Hide from search engines" in the SEO panel (getSeoMeta's `robots`), or the page's own `noindex`.
const robots = noindex ? 'noindex, nofollow' : (meta?.robots ?? undefined);

const page = createPublicPageContext({
  Astro,
  kind: 'custom',
  pageType: type,
  title: fullTitle,
  pageTitle: siteFirst ? fullTitle : title,
  description,
  canonical: canonicalUrl,
  image,
  seo: robots ? { robots } : undefined,
  articleMeta:
    type === 'article'
      ? {
          publishedTime: publishedAt?.toISOString() ?? null,
          modifiedTime: dateModified?.toISOString() ?? null,
          author: authorName ?? null,
        }
      : undefined,
  siteName,
  siteUrl,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <EmDashHead page={page} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#1a1a1a" />
    <link rel="manifest" href="/manifest.json" />
    <link rel="sitemap" href="/sitemap.xml" />
    {preconnect.map((origin) => <link rel="preconnect" href={origin} />)}
    <Font cssVariable="--font-playfair" preload />
    <Font cssVariable="--font-inter" preload />
    <ClientRouter />
  </head>
  <body class={bodyClass}>
    <Header cache={cache} />
    <main>
      <slot />
      {closingBand && <ClosingBand from={bandFrom} primaryLabel={bandLabel} primaryHref={bandHref} lead={bandLead} cache={cache} />}
    </main>
    <FooterFade />
    <Footer cache={cache} />
    <script>
      // Scroll to the #fragment after a view-transition navigation, which
      // ClientRouter does not always do on its own.
      function scrollToHash() {
        const hash = window.location.hash;
        if (hash) {
          const el = document.querySelector(hash);
          if (el) {
            setTimeout(() => {
              el.scrollIntoView({ behavior: 'smooth' });
            }, 100);
          }
        }
      }
      document.addEventListener('astro:after-swap', scrollToHash);
      scrollToHash();
    </script>
  </body>
</html>
