# SuperBenefit Website — Environment Variables
# Copy this file to .env and fill in values. Never commit .env.

# URL for the SuperBenefit knowledge server API.
# When set, blog posts are loaded from this endpoint at build time.
# Leave blank to use built-in mock data (default for local development).
KNOWLEDGE_API_URL=

# ─── /contact form ──────────────────────────────────────────────────────
# Recipient address for the /contact form.
# In production, set as a Cloudflare secret:
#   wrangler secret put CONTACT_EMAIL
# In local dev, this value is read directly by the action.
# NOTE: must also be listed in wrangler.jsonc send_email[].allowed_destination_addresses.
CONTACT_EMAIL=contact@superbenefit.org

# Turnstile secret key (server-side verification).
# In production, set as a Cloudflare secret:
#   wrangler secret put TURNSTILE_SECRET_KEY
# Required: the action returns an error if it is unset. This is Cloudflare's
# always-pass test secret, for local development only.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Turnstile site key (public, sent to the client).
# contact.astro is prerendered, so the key is fixed at build time. Builds
# without a .env take it from `vars` in wrangler.jsonc (the production key).
# The value below is Cloudflare's always-pass test site key.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# ─── EmDash (CMS) ───────────────────────────────────────────────────────
# Origin the CMS uses for setup, emails and the sitemap.
# wrangler.jsonc sets it to https://superbenefit.org in `vars`, and local
# dev reads those vars too, so this override keeps local setup, emails and
# the sitemap on localhost. Passkeys are not used locally while access() is
# configured. `npm run dev` reads this file.
EMDASH_SITE_URL=http://localhost:4321
